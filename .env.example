# PostgreSQL + pgvector
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=knowledge_brain
POSTGRES_USER=brain_user
POSTGRES_PASSWORD=brain_password

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DEFAULT_TTL_SECONDS=3600

# Neo4j
NEO4J_HOST=localhost
NEO4J_BOLT_PORT=7687
NEO4J_HTTP_PORT=7474
NEO4J_USER=neo4j
NEO4J_PASSWORD=brain_graph_password

# Vector Embeddings
EMBEDDING_DIMENSION=1536
EMBEDDING_PROVIDER=mock

# OpenRouter Gateway for JEV
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# JEV Decision Engine
JEV_ENABLED=true
JEV_TIMEOUT_SECONDS=30
JEV_MAX_RETRIES=2
JEV_FALLBACK_ON_ERROR=true

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Obsidian Visualization (Optional)
OBSIDIAN_VAULT_PATH=obsidian_vault

